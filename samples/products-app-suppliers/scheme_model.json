      "name": "Product Catalog",
      "requirements": [
        "REQ-010",
        "REQ-011",
        "REQ-012"
      ],
      "existing": true,
      "expected_change": "Extend the existing product catalog with supplier create/selection/display/filtering without replacing the screen."
    },
    {
      "id": "widget.product-search-filter",
      "type": "widget",
      "name": "Product Search, Category, Availability and Supplier Filter",
      "requirements": [
        "REQ-012"
      ],
      "existing": true,
      "expected_change": "Preserve existing search/category/availability filters and add supplier filtering."
    },
    {
      "id": "widget.supplier-management",
      "type": "widget",
      "name": "Supplier Management",
      "requirements": [
        "REQ-010"
      ],
      "existing": false,
      "implementation_mode": "separate_artifact",
      "owning_artifact_hint": "frontend/src/widgets/SupplierManagement.jsx",
      "expected_change": "Add a compact supplier creation UI in the product catalog prototype context."
    },
    {
      "id": "action.create-product",
      "type": "action",
      "name": "Create Product",
      "requirements": [
        "REQ-011"
      ],
      "existing": true,
      "expected_change": "Extend existing create product behavior so a supplier can be selected while preserving existing fields."
    },
    {
      "id": "action.edit-product",
      "type": "action",
      "name": "Edit Product",
      "requirements": [
        "REQ-011"
      ],
      "existing": true,
      "expected_change": "Extend existing edit product behavior so the product supplier can be changed while preserving existing edit fields."
    },
    {
      "id": "action.adjust-stock",
      "type": "action",
      "name": "Adjust Stock",
      "requirements": [],
