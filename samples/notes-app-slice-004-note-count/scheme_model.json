{
  "scheme_id": "SCH-001",
  "title": "Notes prototype scheme - current state before note-count slice",
  "elements": [
    {
      "id": "screen.note-list",
      "type": "screen",
      "name": "Note List",
      "requirements": [
        "REQ-003",
        "REQ-004",
        "REQ-005",
        "REQ-006"
      ],
      "accepted_behavior": "Displays notes, search, create/edit controls, delete controls, and the confirm-delete flow."
    },
    {
      "id": "widget.note-search",
      "type": "widget",
      "name": "Note Search",
      "requirements": [
        "REQ-004"
      ],
      "accepted_behavior": "Filters the visible note list by the user's search query."
    },
    {
      "id": "action.create-note",
      "type": "action",
      "name": "Create Note",
      "requirements": [
        "REQ-001"
      ],
      "accepted_behavior": "Creates a new note."
    },
    {
      "id": "action.edit-note",
      "type": "action",
      "name": "Edit Note",
      "requirements": [
        "REQ-002"
      ],
      "accepted_behavior": "Edits an existing note."
    },
    {
      "id": "action.delete-note",
      "type": "action",
      "name": "Delete Note",
      "requirements": [
        "REQ-005"
      ],
      "accepted_behavior": "Calls the backend DELETE notes API and removes a note after confirmation."
    },
    {
      "id": "action.confirm-delete-note",
      "type": "action",
      "name": "Confirm Delete Note",
      "requirements": [
        "REQ-006"
      ],
      "implementation_mode": "screen_internal",
      "owning_artifact": "frontend/src/screens/NoteListScreen.jsx",
      "accepted_behavior": "Confirms the pending delete request and invokes the existing delete action/API."
    },
    {
      "id": "action.cancel-delete-note",
      "type": "action",
      "name": "Cancel Delete Note",
      "requirements": [
        "REQ-006"
      ],
      "implementation_mode": "screen_internal",
      "owning_artifact": "frontend/src/screens/NoteListScreen.jsx",
      "accepted_behavior": "Cancels the pending delete request without changing the note list."
    },
    {
      "id": "api.notes",
      "type": "api",
      "name": "Notes API",
      "resource": "notes",
      "requirements": [
        "REQ-001",
        "REQ-002",
        "REQ-003",
        "REQ-005"
      ],
      "accepted_behavior": "Provides CRUD operations for notes."
    },
    {
      "id": "data.note",
      "type": "data_entity",
      "name": "Note",
      "requirements": [
        "REQ-001",
        "REQ-002",
        "REQ-003",
        "REQ-004",
        "REQ-005"
      ]
    },
    {
      "id": "mock.notes-json",
      "type": "mock",
      "name": "Notes JSON",
      "requirements": [
        "REQ-001",
        "REQ-002",
        "REQ-003",
        "REQ-004",
        "REQ-005"
      ]
    }
  ],
  "relations": [
    {
      "from": "screen.note-list",
      "to": "widget.note-search",
      "type": "contains"
    },
    {
      "from": "screen.note-list",
      "to": "action.create-note",
      "type": "contains"
    },
    {
      "from": "screen.note-list",
      "to": "action.edit-note",
      "type": "contains"
    },
    {
      "from": "screen.note-list",
      "to": "action.delete-note",
      "type": "contains"
    },
    {
      "from": "screen.note-list",
      "to": "action.confirm-delete-note",
      "type": "contains"
    },
    {
      "from": "screen.note-list",
      "to": "action.cancel-delete-note",
      "type": "contains"
    },
    {
      "from": "action.delete-note",
      "to": "api.notes",
      "type": "calls"
    },
    {
      "from": "api.notes",
      "to": "data.note",
      "type": "reads_writes"
    },
    {
      "from": "data.note",
      "to": "mock.notes-json",
      "type": "stored_in"
    }
  ],
  "notes": [
    "This model describes the accepted prototype before SLICE-004.",
    "The planner may propose a new note count summary UI element for REQ-007."
  ]
}
