{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "instructions/core/architecture.md",
    "instructions/core/architecture-addons/react-python-json-browser.md",
    "instructions/core/coding.md",
    "instructions/core/file-boundaries.md",
    "instructions/core/traceability.md",
    "agents/prototype-builder.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": "deny",
    "webfetch": "deny",
    "skill": {
      "*": "deny",
      "prototype-crud-flow": "allow"
    }
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "frontend/node_modules/**",
      ".venv/**",
      "dist/**",
      "frontend/dist/**"
    ]
  }
}
