      "expected_change": "Preserve existing Adjust Stock behavior."
    },
    {
      "id": "action.create-supplier",
      "type": "action",
      "name": "Create Supplier",
      "requirements": [
        "REQ-010"
      ],
      "existing": false,
      "implementation_mode": "screen_internal",
      "owning_artifact_hint": "frontend/src/widgets/SupplierManagement.jsx",
      "expected_change": "Create supplier records with name and contact_email."
    },
    {
      "id": "component.product-service",
      "type": "component",
      "name": "Product Service",
      "requirements": [
        "REQ-011",
        "REQ-012"
      ],
      "existing": true,
      "expected_change": "Persist supplier assignment on products and support supplier filtering if implemented server-side. Preserve stock and availability behavior."
    },
    {
      "id": "component.supplier-service",
      "type": "component",
      "name": "Supplier Service",
      "requirements": [
        "REQ-010",
        "REQ-011",
        "REQ-012"
      ],
      "existing": false,
      "implementation_mode": "separate_artifact",
      "owning_artifact_hint": "backend/app/services/supplier_service.py",
      "expected_change": "Add supplier create/list behavior over local JSON mock storage."
    },
    {
      "id": "api.products",
      "type": "api",
      "name": "Products API",
      "resource": "products",
      "requirements": [
        "REQ-011",
        "REQ-012"
      ],
      "existing": true,
      "expected_change": "Preserve existing /api/products behavior and extend it for supplier_id create/edit and optional supplier_id filtering."
    },
    {
      "id": "api.suppliers",
      "type": "api",
      "name": "Suppliers API",
      "resource": "suppliers",
      "requirements": [
        "REQ-010",
        "REQ-011",
        "REQ-012"
      ],
      "existing": false,
      "implementation_mode": "separate_artifact",
      "owning_artifact_hint": "backend/app/api/suppliers.py",
      "expected_change": "Add /api/suppliers list and create endpoints for local supplier records."
    },
    {
      "id": "data.product",
      "type": "data_entity",
      "name": "Product",
      "existing": true,
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "sku",
          "type": "string",
          "required": true
        },
        {
          "name": "category",
          "type": "enum",
          "values": [
            "hardware",
            "software",
            "service"
          ],
          "required": true
        },
        {
          "name": "price",
          "type": "number",
          "required": true
        },
        {
          "name": "stock_quantity",
          "type": "integer",
          "required": true,
          "default": 0,
          "minimum": 0
        },
        {
          "name": "availability_label",
          "type": "derived",
          "required": false,
          "derivation": "Out of Stock when stock_quantity == 0; Low Stock when 1 <= stock_quantity <= 5; In Stock when stock_quantity > 5"
        },
        {
          "name": "supplier_id",
          "type": "string",
          "required": false
        },
        {
          "name": "supplier_name",
          "type": "derived",
          "required": false,
          "derivation": "Display name resolved from supplier_id when supplier data is available"
        }
      ],
      "requirements": [
        "REQ-011",
        "REQ-012"
      ],
      "expected_change": "Add supplier assignment to Product while preserving existing product fields and derived availability label."
    },
    {
      "id": "data.supplier",
      "type": "data_entity",
      "name": "Supplier",
      "existing": false,
      "implementation_mode": "separate_artifact",
      "owning_artifact_hint": "backend/app/models/supplier.py",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "contact_email",
          "type": "string",
          "required": true
        }
      ],
      "requirements": [
        "REQ-010",
        "REQ-011",
        "REQ-012"
      ],
      "expected_change": "Add Supplier entity with name and contact_email for local prototype use."
    },
    {
      "id": "mock.products-json",
      "type": "mock",
      "name": "Products JSON",
      "requirements": [
        "REQ-011",
        "REQ-012"
      ],
      "existing": true,
      "expected_change": "Preserve product mock storage and add supplier_id values where useful for demo filtering."
    },
    {
      "id": "mock.suppliers-json",
      "type": "mock",
      "name": "Suppliers JSON",
      "requirements": [
        "REQ-010",
        "REQ-011",
        "REQ-012"
      ],
      "existing": false,
      "implementation_mode": "separate_artifact",
      "owning_artifact_hint": "backend/app/storage/suppliers_json_mock.json",
      "expected_change": "Add local JSON mock records for suppliers."
    }
