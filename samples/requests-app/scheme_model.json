      "requirements": [
        "REQ-001",
        "REQ-002",
        "REQ-003",
        "REQ-004",
        "REQ-005",
        "REQ-006"
      ]
    },
    {
      "id": "mock.requests-json",
      "type": "mock",
      "name": "Requests JSON",
      "requirements": [
        "REQ-001",
        "REQ-002",
